@PACKAGE_INIT@

cmake_minimum_required(VERSION 3.16)

if(SevenTools_FOUND)
    return()
endif()

set(SevenTools_FOUND False)

find_path(MACROS NAME "CppVersions.h" HINTS @CMAKE_INSTALL_PREFIX@/include/Macros NO_DEFAULT_PATH)
find_path(THREADS NAME "ThreadPool.h" HINTS @CMAKE_INSTALL_PREFIX@/include/Threads NO_DEFAULT_PATH)
find_path(UTILITY NAME "OperationStream.h" HINTS @CMAKE_INSTALL_PREFIX@/include/Utility NO_DEFAULT_PATH)
find_library(SevenTools_LIBRARY NAME SevenTools HINTS @CMAKE_INSTALL_PREFIX@/lib NO_DEFAULT_PATH)
if(MACROS STREQUAL "MACROS-NOTFOUND" OR
    THREADS STREQUAL "THREADS-NOTFOUND" OR
    UTILITY STREQUAL "UTILITY-NOTFOUND" OR
    SevenTools_LIBRARY STREQUAL "SevenTools_LIBRARY-NOTFOUND")
    return()
else()
    list(APPEND SevenTools_INCLUDE_DIRS ${MACROS} ${THREADS} ${UTILITY} @CMAKE_INSTALL_PREFIX@/include)
endif()
include_directories(${SevenTools_INCLUDE_DIRS})

if(@BUILD_SHARED@)
    add_compile_definitions(SharedSevenTools)
    add_library(SevenTools SHARED IMPORTED GLOBAL)
    if(WIN32)
        # CMAKE_FIND_LIBRARY_PREFIXES 可能有多个值
        foreach(prefix IN LISTS CMAKE_FIND_LIBRARY_PREFIXES)
            list(APPEND LIBRARY_NAME ${prefix}SevenTools.dll)
        endforeach()
        # find_library 不找dll(但找so)
        find_file(RLib
            NAME
                ${LIBRARY_NAME}
            HINTS
                @CMAKE_INSTALL_PREFIX@/bin
            NO_DEFAULT_PATH
        )
        if(RLib STREQUAL "RLib-NOTFOUND")
            return()
        endif()
        set_target_properties(SevenTools PROPERTIES IMPORTED_LOCATION ${RLib} IMPORTED_IMPLIB ${SevenTools_LIBRARY})
    else()
        set_target_properties(SevenTools PROPERTIES IMPORTED_LOCATION ${SevenTools_LIBRARY})
    endif()
else()
    add_library(SevenTools STATIC IMPORTED GLOBAL)
    set_target_properties(SevenTools PROPERTIES IMPORTED_LOCATION ${SevenTools_LIBRARY})
endif()
set(SevenTools_LIBRARY_DIRS @CMAKE_INSTALL_PREFIX@/lib)

set(SevenTools_VERSION @PROJECT_VERSION@)

set(SevenTools_FOUND True)